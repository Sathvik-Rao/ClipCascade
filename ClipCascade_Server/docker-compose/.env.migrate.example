# Copy to .env next to docker-compose.migrate-from-latest.yml
#
# .env is gitignored; this example file is not. Keep real addresses and real
# secrets in .env only.

# Image: build locally first, or point at a registry tag you publish.
CLIPCASCADE_IMAGE=clipcascade:hardening

# Host bind address. Use this machine's Tailscale IP: tailscale ip -4
# Binding to the tailnet address keeps the server off every other interface.
CC_BIND_ADDRESS=100.64.0.1

# Exact browser/client origins (comma-separated). Replace the old compose's *:
# the server now refuses to start on CC_ALLOWED_ORIGINS=*, because a wildcard
# lets any website open an authenticated WebSocket with the visitor's cookie
# and read their clipboard. Include every scheme/host/port you actually open —
# add the MagicDNS name too if you browse via *.ts.net.
CC_ALLOWED_ORIGINS=http://100.64.0.1:8080

# H2 cipher passwords — MUST match the existing volume's data.
# Format is "<filePassword> <userPassword>": the space is required, because the
# datasource URL uses CIPHER=AES.
# If you never set CC_SERVER_DB_PASSWORD on sathvikrao/clipcascade:latest, the
# upstream baked-in default was the value below. It is already public (it
# shipped in application.properties), so rotate it once the migration is
# verified.
CC_SERVER_DB_PASSWORD=QjuGlhE3uwylBBANMkX1 o2MdEoFgbU5XkFvTftky

# Only applied when the user table is empty. Leave unset when migrating an
# existing volume, where the admin already exists.
# CC_INITIAL_ADMIN_PASSWORD=

# Set only if the server sits behind a reverse proxy you control, as a
# comma-separated CIDR list of that proxy's addresses. When unset (the default)
# X-Forwarded-For is ignored entirely and the socket peer is authoritative,
# which is what you want for a direct Tailscale bind.
# Narrow: ideally the single proxy host. Never a range containing clients —
# anything inside it may declare its own address and choose its own
# brute-force lockout key.
# CC_TRUSTED_PROXY_CIDRS=172.18.0.2/32

# Sessions lasted a year on `latest`; the hardened default is 24h. Uncomment to
# keep the old behaviour instead of re-logging in daily.
# CC_SESSION_TIMEOUT=525960m

CC_MAX_MESSAGE_SIZE_IN_MiB=100
CC_P2P_ENABLED=false
CC_SIGNUP_ENABLED=false
CC_UPDATE_CHECK_ENABLED=false
TZ=UTC
JAVA_TOOL_OPTIONS=-Xmx4g -Xms512m
# A 100 MiB message buffers ~2x per WebSocket session on top of the heap, so
# leave headroom above -Xmx or the container gets OOM-killed (exit 137).
CC_MEM_LIMIT=6g
