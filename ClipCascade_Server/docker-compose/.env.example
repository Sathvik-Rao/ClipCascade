CLIPCASCADE_IMAGE=your-registry/clipcascade:3.2.0

# Host address to publish on. Defaults to 127.0.0.1 when unset.
# Use a Tailscale IP (tailscale ip -4) or a LAN IP to reach it from other
# machines. 0.0.0.0 publishes on every interface — only behind a firewall.
# CC_BIND_ADDRESS=127.0.0.1

# Exact origins only, comma-separated. The server refuses to start on *,
# because a wildcard lets any website open an authenticated WebSocket with a
# visitor's cookie and read their clipboard.
CC_ALLOWED_ORIGINS=http://localhost:8080

CC_INITIAL_ADMIN_PASSWORD=replace-with-strong-password
# H2 with CIPHER=AES takes two values separated by one space:
# "<file password> <user password>". The space is required.
CC_SERVER_DB_PASSWORD=replace-file-password replace-user-password

# Only if behind a reverse proxy you control: CIDRs of that proxy. When unset,
# X-Forwarded-For is ignored and the socket peer is authoritative, so clients
# cannot forge the IP used for brute-force limits.
# Narrow: ideally the single proxy host. Never a range containing clients —
# anything inside it may declare its own address and choose its own
# brute-force lockout key.
# CC_TRUSTED_PROXY_CIDRS=172.18.0.2/32

# --- Tailscale self-host (see docs/TAILSCALE.md) ---
# CC_BIND_ADDRESS=100.64.1.10
# Comma-separated exact origins clients will use (HTTP OK on tailnet):
# CC_ALLOWED_ORIGINS=http://homeserver.tail-XXXX.ts.net:8080,http://100.64.1.10:8080
# CC_P2P_ENABLED=false
# CC_SIGNUP_ENABLED=false
# CC_UPDATE_CHECK_ENABLED=false
# Then: docker compose -f docker-compose.yml -f docker-compose.tailscale.yml up -d

# External broker example only:
ACTIVEMQ_IMAGE=apache/activemq-classic:6.1.4
ACTIVEMQ_ADMIN_LOGIN=replace-with-strong-username
ACTIVEMQ_ADMIN_PASSWORD=replace-with-strong-password

# PostgreSQL example only:
POSTGRES_IMAGE=postgres:16
POSTGRES_PASSWORD=replace-with-strong-password
