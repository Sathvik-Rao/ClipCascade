# Rendered by the official nginx image; mounted into its http context.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Re-resolve Docker DNS after the backend container is recreated.
resolver 127.0.0.11 valid=30s ipv6=off;
upstream clipcascade_backend {
    zone clipcascade_backend 64k;
    server clipcascade:8080 resolve;
}

server {
    listen 80;
    server_name ${DOMAIN};
    return 308 https://${DOMAIN}:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # One location preserves every HTTP API and BOTH WebSocket endpoints.
    location / {
        proxy_pass http://clipcascade_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        # The public port can differ from this container's port 443.
        proxy_set_header X-Forwarded-Port ${HTTPS_PORT};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        # This is an internet-facing edge, not a second trusted proxy hop.
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        proxy_cache off;
    }
}
