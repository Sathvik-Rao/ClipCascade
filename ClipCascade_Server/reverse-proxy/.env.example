# Copy to .env and edit these values before starting ONE proxy overlay.
DOMAIN=clipboard.example.com
ACME_EMAIL=you@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Nginx needs an existing certificate for DOMAIN in this directory:
# fullchain.pem and privkey.pem. Renew it with your certificate provider.
NGINX_CERT_DIR=./certs

# P2S is the simplest mode, including on networks that block direct P2P traffic.
CC_P2P_ENABLED=false
CC_MAX_MESSAGE_SIZE_IN_MiB=1
CC_SESSION_PERSISTENCE_ENABLED=false

# Optional: restrict WebSocket origins AFTER setting DOMAIN and HTTPS_PORT.
# Use the exact public origin; omit :443 for the standard HTTPS port.
# CC_ALLOWED_ORIGINS=https://clipboard.example.com
# CC_ALLOWED_ORIGINS=https://clipboard.example.com:8743

# Optional image override to pin a version. Otherwise compose.yml uses latest.
# CLIPCASCADE_IMAGE=your-registry/clipcascade:your-tag

# For an existing containerized proxy only: its existing Docker network name.
# PROXY_NETWORK=proxy

# For an existing proxy running directly on this host only:
# BACKEND_PORT=8080
