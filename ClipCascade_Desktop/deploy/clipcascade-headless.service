[Unit]
Description=ClipCascade headless clipboard sync
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/clip-cascade/ClipCascade_Desktop/src
Environment=XDG_SESSION_TYPE=wayland
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=%t
ExecStart=%h/.local/share/clipcascade-venv/bin/python %h/clip-cascade/ClipCascade_Desktop/deploy/clipcascade-headless --xmode false
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
